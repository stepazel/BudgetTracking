@page
@model IndexModel
@{
    ViewData["Title"] = "Doma";
}

<div>
    <h1>Výdaje</h1>

    <table>
        <thead>
        <tr>
            <td>Částka</td>
            <td>Výdaj</td>
            <td>Datum</td>
            <td>Kategorie</td>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Expenses)
        {
            <tr>
                <td>@item.Amount Kč</td>
                <td>@item.Description</td>
                <td>@item.Created.ToString("dd.M")</td>
                <td>@item.CategoryName</td>
                <td>
                    <button>Smazat</button>
                </td>
            </tr>
        }
        <form method="post">
            <tr>
                <td>
                    <label>
                        Částka
                        <input asp-for="NewExpense.Amount" type="number"/>
                    </label>
                </td>
                <td>
                    <label>
                        Popis
                        <input asp-for="NewExpense.Description" type="text"/>
                    </label>
                </td>
                <td>
                        <select asp-for="NewExpense.CategoryId">
                            @foreach (var category in Model.UserCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                </td>
                <td>
                    <label>
                        Datum
                        <input asp-for="NewExpense.Created" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                    </label>
                </td>
                <td>
                    <button>Vytvořit</button>
                </td>
            </tr>
        </form>
        </tbody>
    </table>

</div>