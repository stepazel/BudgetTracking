@model BudgetTrackingApp.Models.Expenses.Model

<div class="text-center">
  <table class="table">`
    <thead>
    <tr>
      <th>Částka</th>
      <th>Popis</th>
      <th>Datum</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var expense in Model.Expenses)
    {
      <tr>
        <td>@expense.Amount Kč</td>
        <td>@expense.Description</td>
        <td>@expense.Created.Date.ToString("dd.MM.yy")</td>
        <td>
          <button hx-delete="/Home/DeleteExpense" value="@expense.Id" name="id" hx-target="body" hx-swap="innerHTML">
            <i class="fa fa-trash-o"></i>
          </button>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>