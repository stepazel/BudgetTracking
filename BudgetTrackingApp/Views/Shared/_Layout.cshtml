<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
<header>
  <nav>
    <ul class="nav">
      @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
      {
        <li class="nav-item">
          <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">Domů</a>
        </li>
      }
      <li class="nav-item">
        <a class="nav-link" asp-controller="Insights" asp-action="Index">Statistiky</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" asp-controller="User" asp-action="ManageUserCategories">Kategorie</a>
      </li>
      <li class="nav-item">
        @if (Context.User.Identity?.IsAuthenticated == true)
        {
          <a class="nav-link" asp-controller="User" asp-action="Logout">Odhlásit se</a>
        }
        else
        {
          <a class="nav-link" asp-controller="User" asp-action="Index">Přihlásit se</a>
        }
      </li>
    </ul>
  </nav>
</header>

<main class="pb-3">
  @RenderBody()
</main>

<footer class="footer">
  Neutrácej tolik.
</footer>

<script src="https://unpkg.com/htmx.org@1.9.8"></script>


<script src="~/js/site.js" asp-append-version="true"></script>

<script>
  let lastScrollY = window.scrollY;
  const footer = document.querySelector('.footer');

  window.addEventListener('scroll', () => {
    if (window.scrollY > lastScrollY) {
      footer.classList.add('hidden');
    } else {
      footer.classList.remove('hidden');
    }
    lastScrollY = window.scrollY;
  });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>